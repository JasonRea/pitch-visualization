# Copy to .env and fill in values for local development.
# Set these in the Render.com dashboard for production (Dashboard → service → Environment).

# GitHub fine-grained PAT with "Actions: write" permission on this repo.
GITHUB_TOKEN=ghp_...

# GitHub repo details — used to trigger workflow_dispatch and poll run status.
GITHUB_OWNER=your_github_username
GITHUB_REPO=pitch-vizualization

# DigitalOcean Spaces — must match the values already used in daily_vizualization.yml.
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=your_bucket_name

# CORS-allowed origin for API clients. Set to your deployed client's URL in production.
# Defaults to * (allow all) if not set — fine for local dev, lock it down in prod.
ALLOWED_ORIGIN=http://localhost:5173
